COMPOSE_PROJECT_NAME=la-despensa

# URL y puerto local
WP_PORT=8080
WP_URL=http://localhost:8080
TZ=America/Santiago

# UID/GID del host (ejecuta `id -u` y `id -g`)
HOST_UID=1000
HOST_GID=1000

# Base de datos
DB_NAME=ladespensa
DB_USER=ladespensa
DB_PASSWORD=cambia_esto
DB_ROOT_PASSWORD=cambia_esto

# Sitio y usuario administrador
WP_TITLE=La Despensa
WP_ADMIN_USER=ladespensa
WP_ADMIN_PASSWORD=cambia_esto
WP_ADMIN_EMAIL=admin@example.com
